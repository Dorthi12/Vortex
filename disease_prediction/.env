# ── DATABASE ──────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=disease_intel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/disease_intel

# ── REDIS ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ── KAFKA ─────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CITIZEN_REPORTS=citizen_reports
KAFKA_TOPIC_WEATHER_UPDATES=weather_updates
KAFKA_TOPIC_DISEASE_CASES=disease_cases
KAFKA_TOPIC_OUTBREAK_PREDICTIONS=outbreak_predictions
KAFKA_TOPIC_GOVERNMENT_ACTIONS=government_actions
KAFKA_CONSUMER_GROUP=disease-intel-group

# ── APP SETTINGS ──────────────────────────────────────────────
APP_NAME=Disease Intelligence System
APP_VERSION=2.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ── ML MODEL SETTINGS ─────────────────────────────────────────
MODEL_RETRAIN_INTERVAL_HOURS=24
MIN_ACCURACY_THRESHOLD=0.80
MODEL_SAVE_PATH=./models/saved/
OUTBREAK_PROB_ALERT_THRESHOLD=0.7

# ── ALERT SETTINGS ────────────────────────────────────────────
ALERT_OUTBREAK_PROB_THRESHOLD=0.7
ALERT_RISK_SCORE_THRESHOLD=75
ALERT_CASES_THRESHOLD=50
